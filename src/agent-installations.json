  "qoder": { "commands": [{ "name": "qoder" }, { "name": "qodercli" }], "windows": ["$LOCALAPPDATA/Programs/Qoder/Qoder.exe", "$PROGRAMFILES/Qoder/Qoder.exe"], "macos": ["/Applications/Qoder.app", "~/Applications/Qoder.app"], "configDirectories": ["~/.qoder"] },
  "codebuddy": { "commands": [{ "name": "codebuddy" }], "windows": ["$LOCALAPPDATA/Programs/CodeBuddy/CodeBuddy.exe", "$PROGRAMFILES/CodeBuddy/CodeBuddy.exe"], "macos": ["/Applications/CodeBuddy.app", "~/Applications/CodeBuddy.app"], "configDirectories": ["~/.codebuddy"] },
  "kimi-code-cli": { "commands": [{ "name": "kimi", "markers": [".kimi-code", "kimi-code"], "excludeMarkers": ["kimi_cli"] }], "configDirectories": ["$KIMI_CODE_HOME"] },
  "kimi-cli-legacy": { "commands": [{ "name": "kimi", "markers": ["kimi_cli", "kimi-cli"], "excludeMarkers": [".kimi-code"] }], "configDirectories": ["~/.kimi"] },
  "junie": { "commands": [{ "name": "junie" }], "configDirectories": ["~/.junie"] },
  "zencoder": { "extensions": ["zencoderai.zencoder"], "windows": ["$LOCALAPPDATA/Programs/Zenflow/Zenflow.exe"], "macos": ["/Applications/Zenflow.app", "~/Applications/Zenflow.app"], "configDirectories": ["~/.zencoder"] },
  "openclaw": { "commands": [{ "name": "openclaw" }], "configDirectories": ["~/.openclaw"] },
  "hermes-agent": { "commands": [{ "name": "hermes", "markers": ["hermes-agent", "hermes_cli", ".hermes"] }], "configDirectories": ["$HERMES_HOME"] },
  "zcode": { "windows": ["$LOCALAPPDATA/Programs/ZCode/ZCode.exe", "$PROGRAMFILES/ZCode/ZCode.exe"], "macos": ["/Applications/ZCode.app", "~/Applications/ZCode.app"], "configDirectories": ["~/.zcode"] },
  "workbuddy": { "windows": ["$LOCALAPPDATA/Programs/WorkBuddy/WorkBuddy.exe", "$PROGRAMFILES/WorkBuddy/WorkBuddy.exe"], "macos": ["/Applications/WorkBuddy.app", "~/Applications/WorkBuddy.app"] },
