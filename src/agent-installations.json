  "openhands": { "commands": [{ "name": "openhands" }], "configDirectories": ["~/.openhands"] },
  "cline": { "commands": [{ "name": "cline" }], "extensions": ["saoudrizwan.claude-dev"], "configDirectories": ["~/.cline"] },
  "goose": { "commands": [{ "name": "goose" }], "windows": ["$LOCALAPPDATA/Programs/goose/goose.exe"], "macos": ["/Applications/Goose.app", "~/Applications/Goose.app"], "configDirectories": ["$XDG_CONFIG_HOME/goose"] },
