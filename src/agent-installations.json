{
  "claude-code": { "commands": [{ "name": "claude" }], "extensions": ["anthropic.claude-code"], "configDirectories": ["$CLAUDE_CONFIG_DIR"] },
  "cursor": { "commands": [{ "name": "cursor" }, { "name": "cursor-agent" }], "windows": ["$LOCALAPPDATA/Programs/cursor/Cursor.exe", "$PROGRAMFILES/Cursor/Cursor.exe"], "macos": ["/Applications/Cursor.app", "~/Applications/Cursor.app"], "linux": ["/opt/Cursor/cursor", "/opt/cursor/cursor"], "configDirectories": ["~/.cursor"] },
