  "grok-build": { "commands": [{ "name": "grok" }], "configDirectories": ["$GROK_HOME"] },
  "kiro": { "commands": [{ "name": "kiro" }, { "name": "kiro-cli" }], "windows": ["$LOCALAPPDATA/Programs/Kiro/Kiro.exe", "$PROGRAMFILES/Kiro/Kiro.exe"], "macos": ["/Applications/Kiro.app", "~/Applications/Kiro.app"], "linux": ["/usr/share/kiro/kiro", "/opt/kiro/kiro"], "configDirectories": ["~/.kiro"] },
