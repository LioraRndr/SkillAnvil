  "devin-cli": { "commands": [{ "name": "devin" }], "configDirectories": ["$XDG_CONFIG_HOME/devin"] },
  "opencode": { "commands": [{ "name": "opencode" }], "windows": ["$LOCALAPPDATA/Programs/OpenCode/OpenCode.exe", "$LOCALAPPDATA/OpenCode/OpenCode.exe"], "macos": ["/Applications/OpenCode.app", "~/Applications/OpenCode.app"], "configDirectories": ["$XDG_CONFIG_HOME/opencode"] },
