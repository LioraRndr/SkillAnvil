{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillAnvil",
  "version": "0.1.0",
  "identifier": "dev.skillanvil.app",
  "build": {
    "beforeDevCommand": "pnpm vite:dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkillAnvil",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
